## Test Data Management

### Fixtures
```typescript
// test/fixtures/product.fixtures.ts
export const productFixtures = {
  validProduct: {
    title: "Test Product",
    description: "Test Description",
    // ... other fields
  },
  invalidProduct: {
    // Missing required fields
  },
}
```

### Test Database
- Use separate test database
- Clean up data between tests
- Use transactions for isolation
- Seed test data as needed

### Factory Patterns
```typescript
// test/factories/product.factory.ts
export class ProductFactory {
  static create(overrides = {}) {
    return {
      title: "Factory Product",
      description: "Factory Description",
      ...overrides,
    }
  }

  static createMany(count: number, overrides = {}) {
    return Array.from({ length: count }, () => this.create(overrides))
  }
}
```

## API Testing

### HTTP Endpoint Testing
```typescript
import request from "supertest"
import { createApp } from "../src/app"

describe("Product API", () => {
  let app: Express

  beforeAll(async () => {
    app = await createApp()
  })

  it("should create product via API", async () => {
    const response = await request(app)
      .post("/admin/products")
      .send({
        title: "API Test Product",
      })
      .expect(201)

    expect(response.body.product).toBeDefined()
    expect(response.body.product.title).toBe("API Test Product")
  })

  it("should handle validation errors", async () => {
    await request(app)
      .post("/admin/products")
      .send({}) // Empty payload
      .expect(400)
  })
})
```

### Authentication Testing
```typescript
// Test authenticated endpoints
const authHeaders = {
  Authorization: `Bearer ${testJwtToken}`,
}

await request(app)
  .get("/admin/products")
  .set(authHeaders)
  .expect(200)
```

## Workflow Testing

### Workflow Execution Testing
```typescript
import { createProductWorkflow } from "../src/workflows/create-product"

describe("Create Product Workflow", () => {
  it("should execute workflow successfully", async () => {
    const workflow = createProductWorkflow(container)
    
    const result = await workflow.run({
      title: "Workflow Test Product",
    })

    expect(result.product).toBeDefined()
    expect(result.inventory).toBeDefined()
  })

  it("should handle workflow failures", async () => {
    const workflow = createProductWorkflow(container)
    
    await expect(workflow.run({
      // Invalid input
    })).rejects.toThrow()
  })
})
```

## Performance Testing

### Load Testing
```typescript
// Test performance under load
describe("Performance Tests", () => {
  it("should handle concurrent product creation", async () => {
    const promises = Array.from({ length: 100 }, () =>
      productService.create({
        title: `Concurrent Product ${Math.random()}`,
      })
    )

    const results = await Promise.all(promises)
    expect(results).toHaveLength(100)
  })
})
```

