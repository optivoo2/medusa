# Exclude large directories and files
node_modules
.git
.vercel
*.log
*.tmp
*.temp
coverage
.nyc_output
dist
build
.next
my-storefront/node_modules
my-storefront/.next
my-storefront/dist
my-storefront/build
my-storefront/coverage
