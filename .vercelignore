my-storefront/*.tmp
my-storefront/*.temp

# Exclude development files
.env.local
.env.development
.env.test
*.env
production-secrets.txt
*.md
!README.md
docs/
examples/
tests/
test/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

