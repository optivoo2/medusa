# 🚀 Docker ignore file for optimized builds

# Node modules
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next/
dist/
build/
coverage/

# Environment files (will be injected by platform)
.env*
!.env.example
!production.env.example

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime
.pid
.seed
.coverage

# Documentation (not needed in container)
docs/
*.md
!README.md

# Integration tests (not needed in production)
integration-tests/

# Development tools
.eslintrc*
.prettierrc*
jest.config.js

# Temporary files
tmp/
temp/

# Package manager
.npm/
.yarn/
.pnpm/
