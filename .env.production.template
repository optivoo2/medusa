# Medusa Production Environment Configuration

# CRITICAL: Required Environment Variables
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (Required)
# Replace with your actual Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/medusa_production

# Security Secrets (Required) - CHANGE THESE!
JWT_SECRET=your-super-secure-jwt-secret-here-min-32-chars
COOKIE_SECRET=your-super-secure-cookie-secret-here-min-32-chars
ADMIN_JWT_SECRET=your-super-secure-admin-jwt-secret-here-min-32-chars

# CORS Configuration
STORE_CORS_ORIGIN=https://store.optivoo.com
ADMIN_CORS_ORIGIN=https://admin.store.optivoo.com
CORS_ORIGIN=https://store.optivoo.com,https://admin.store.optivoo.com

# Redis Configuration (Recommended for production)
# REDIS_URL=redis://localhost:6379

# File Storage - AWS S3 (Recommended for production)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-s3-bucket-name
# S3_PREFIX=medusa
# S3_FILE_URL=https://your-s3-bucket.s3.amazonaws.com

# Email Configuration - SendGrid (Recommended for production)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@optivoo.com

# Optional: Logging and Monitoring
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn

# Health Check Configuration
HEALTHCHECK_URL=http://localhost:3000/health